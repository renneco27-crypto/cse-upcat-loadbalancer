# Target URLs in priority order
ORIGIN_URLS=https://upcat-reviewer.onrender.com, https://backup-upcat.example.com

# Keywords on the website that indicate it is suspended or in maintenance
MAINTENANCE_KEYWORDS=This service has been suspended,under maintenance,scheduled maintenance

# Health check timeout in ms
TIMEOUT_MS=3000

# Redirect status code
REDIRECT_STATUS=302

# Local port
PORT=3000
